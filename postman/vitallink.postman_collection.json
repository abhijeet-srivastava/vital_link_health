  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Mints the dev-issuer HS256 tokens query-api accepts (same claims as scripts/mint-dev-token.sh).",
          "const secret = pm.environment.get('jwt_secret') || '';",
          "const b64url = (words) => CryptoJS.enc.Base64.stringify(words)",
          "    .replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "const json64 = (obj) => b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(obj)));",
          "function mint(sub, actor, scope) {",
          "    const now = Math.floor(Date.now() / 1000);",
          "    const unsigned = json64({ alg: 'HS256', typ: 'JWT' }) + '.' + json64({",
          "        iss: pm.environment.get('jwt_issuer'), aud: pm.environment.get('jwt_audience'),",
          "        sub: String(sub), vl_actor: actor, scope: scope, iat: now, exp: now + 3600 });",
          "    return unsigned + '.' + b64url(CryptoJS.HmacSHA256(unsigned, secret));",
          "}",
          "if (secret.length < 32) {",
          "    console.warn('jwt_secret must be VITALLINK_DEV_JWT_SECRET from .env (at least 32 bytes); query-api calls will be 401');",
          "}",
          "const coach = pm.environment.get('coach_id');",
          "pm.collectionVariables.set('coach_token', mint(coach, 'COACH', 'readings:read alerts:read alerts:write'));",
          "pm.collectionVariables.set('coach_readonly_token', mint(coach, 'COACH', 'readings:read'));",
          "pm.collectionVariables.set('clinician_token', mint(pm.environment.get('clinician_sub'), 'CLINICIAN', 'thresholds:write'));",
          "pm.collectionVariables.set('service_token', mint(pm.environment.get('service_sub'), 'SERVICE', 'assignments:write'));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// query-api errors are RFC 7807 problem+json with a machine-readable code.",
          "if (pm.response.code >= 400 && pm.request.url.toString().startsWith(pm.environment.get('query_url'))) {",
          "    pm.test('error body is problem+json with a code', () => {",
          "        pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
          "        pm.expect(pm.response.json()).to.have.property('code');",
          "    });",
          "}"
        ]
      }
    }
  ],

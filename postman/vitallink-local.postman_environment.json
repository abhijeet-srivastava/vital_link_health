{
  "name": "VitalLink local",
  "values": [
    {
      "key": "ingest_url",
      "value": "http://localhost:8081",
      "type": "default",
      "enabled": true
    },
    {
      "key": "query_url",
      "value": "http://localhost:8083",
      "type": "default",
      "enabled": true
    },
    {
      "key": "jwt_secret",
      "value": "<VITALLINK_DEV_JWT_SECRET from .env>",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "jwt_issuer",
      "value": "vitallink-dev",
      "type": "default",
      "enabled": true
    },
    {
      "key": "jwt_audience",
      "value": "query-api",
      "type": "default",
      "enabled": true
    },
    {
      "key": "device_id",
      "value": "2",
      "type": "default",
      "enabled": true
    },
    {
      "key": "device_key",
      "value": "<key from: docker compose logs seed | grep 'device_id=2 key='>",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "patient_id",
      "value": "2",
      "type": "default",
      "enabled": true
    },
    {
      "key": "coach_id",
      "value": "2",
      "type": "default",
      "enabled": true
    },
    {
      "key": "outside_patient_id",
      "value": "3",
      "type": "default",
      "enabled": true
    },
    {
      "key": "other_coach_id",
      "value": "3",
      "type": "default",
      "enabled": true
    },
    {
      "key": "clinician_sub",
      "value": "dr-7",
      "type": "default",
      "enabled": true
    },
    {
      "key": "service_sub",
      "value": "care-admin",
      "type": "default",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment"
}

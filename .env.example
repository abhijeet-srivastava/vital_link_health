# Copy to .env (git-ignored) and change the password. Local development only; production uses a secrets manager.
POSTGRES_DB=vitallink
POSTGRES_USER=vitallink
POSTGRES_PASSWORD=change-me
# Any 22-char base64 id; generate a fresh one with: docker run --rm apache/kafka:3.9.2 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
